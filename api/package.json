{
  "name": "@haulledger/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply haulledger --local",
    "db:migrate:remote": "wrangler d1 migrations apply haulledger --remote",
    "db:seed:local": "mkdir -p .wrangler && node ../scripts/seed.mjs > .wrangler/seed.sql && wrangler d1 execute haulledger --local --file=.wrangler/seed.sql"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "@cloudflare/vitest-plugin": "^1.4.4"
  }
}
